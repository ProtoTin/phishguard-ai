# Copy this file to .env for local overrides. Do not commit .env.
PHISHGUARD_APP_NAME="PhishGuard API"
PHISHGUARD_ENVIRONMENT="development"
PHISHGUARD_MODEL_REPORT_PATH="reports/model-evaluation.json"
PHISHGUARD_POLICY_PATH="config/detection-policy.json"
PHISHGUARD_MAX_REQUEST_BYTES=65536
PHISHGUARD_ANALYSIS_TIMEOUT_SECONDS=5
PHISHGUARD_ANALYSIS_RATE_LIMIT=30
PHISHGUARD_ANALYSIS_RATE_WINDOW_SECONDS=60
# Add the public deployment hostname before running in production.
PHISHGUARD_ALLOWED_HOSTS="localhost,127.0.0.1"
